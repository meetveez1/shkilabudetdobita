      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/api/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": $json.payload,\n  \"limit\": 5\n}",
        "options": {}
      },
      "id": "search-api",
      "name": "HTTP SEARCH API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        30
      ]
    },
    {
      "parameters": {
        "jsCode": "const src = $('Code (Parse Command)').item.json;\nconst data = $json;\nconst hits = data.hits || [];\n\nif (!hits.length) {\n  return [{ json: { chatId: src.chatId, text: 'Ничего не найдено.' } }];\n}\n\nlet txt = `Найдено: ${hits.length}`;\nhits.slice(0,5).forEach((h, i) => {\n  const chunk = (h.text || '').slice(0, 220);\n  txt += `\\n\\n${i+1}) ${h.book_title}, ${h.chapter || '—'}, #${h.chunk_index}\\n${chunk}`;\n});\n\nreturn [{ json: { chatId: src.chatId, text: txt } }];"
      },
      "id": "format-search",
      "name": "Code (Format SEARCH)",
      "type": "n8n-nodes-base.code",
